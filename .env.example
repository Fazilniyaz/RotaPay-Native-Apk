# Copy this file to `.env` and fill in your values.
# Expo automatically loads EXPO_PUBLIC_* vars into the app at build/dev time.

# Optional: override the backend base URL (defaults to http://localhost:5000).
# EXPO_PUBLIC_API_URL=http://localhost:5000

# ── Google OAuth ("Continue with Google") ──────────────────────────────────
# Create OAuth 2.0 Client IDs in Google Cloud Console → APIs & Services → Credentials.
# The Native app sends the Google ID token to POST /api/auth/google (same as the
# Admin web app). The backend must be configured with the SAME Google project.
#
#  • WEB      — "Web application" client. Required for Expo Web AND Expo Go.
#               Add your dev origin (e.g. http://localhost:8081) to
#               "Authorized JavaScript origins" and "Authorized redirect URIs".
#  • IOS      — "iOS" client (bundle id must match app.json). Native builds only.
#  • ANDROID  — "Android" client (package name + SHA-1). Native builds only.
#
# Without these set, the button shows "Google sign-in isn’t configured yet."
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
